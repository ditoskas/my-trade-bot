.idea

# workspace-wide (per-app .gitignore files, e.g. apps/ui/.gitignore, cover
# framework-specific build output like .next/)
node_modules/
dist/
*.tsbuildinfo

# apps/engine's long-running diagnostic scripts (e.g.
# btcHighRiskLiveShadow.ts) write their own logs here — real output, not
# source, never committed.
apps/engine/logs/

# secrets — never commit real Binance/Telegram/Mongo credentials
.env
.env.*
!.env.example

# ansible/group_vars/all.yml holds real SSH/domain/basic-auth/API secrets
# filled in from all.yml.example — never commit the filled-in version.
ansible/group_vars/all.yml
ansible/*.retry
