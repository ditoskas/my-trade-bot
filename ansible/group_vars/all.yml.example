# ============================================================================
# Fill in every "CHANGE ME" below, then copy this file to all.yml:
#
#   cp ansible/group_vars/all.yml.example ansible/group_vars/all.yml
#
# all.yml is gitignored (see .gitignore) — it will hold real secrets
# (SSH details, the dashboard password, API tokens) once filled in, and
# must never be committed.
# ============================================================================

# ---- SSH connection to the target server ----
server_host: "CHANGE ME"          # e.g. 203.0.113.10, or a hostname
ssh_username: "CHANGE ME"         # e.g. root, or a sudo-capable user
ssh_port: 22
# SSH key selection isn't a variable here on purpose — see inventory.yml's
# comment on why. Use your SSH agent (`ssh-add /path/to/key`), an
# `IdentityFile` entry in `~/.ssh/config` for this host, or pass
# `--private-key=/path/to/key` on the ansible-playbook command line.

# The whole playbook runs with become: true (sudo). Set this so you're not
# prompted on every run, or leave it "" / delete the line to be prompted
# via --ask-become-pass instead. If ssh_username already has passwordless
# sudo on the server, you don't need this at all.
become_password: ""

# ---- Domain / nginx ----
domain_name: "trade.toskas.gr"
# This nginx vhost listens on 127.0.0.1 only, not the public port 80/443 —
# set nginx_internal_port to whatever's free (8081 is just a default).
# See README.md's "Coexisting with another nginx on the same server"
# section: if something else on this box (another app, another nginx,
# GitLab's own bundled one, etc.) already owns port 80/443, that other
# nginx needs one small, manually-applied config addition to reverse-proxy
# domain_name to this port — this playbook deliberately does not touch
# another service's config on its own.
nginx_internal_port: 8081
# certbot/Let's Encrypt below only works if THIS nginx is the one actually
# reachable on port 80 (its HTTP-01 challenge needs that). In the
# coexistence setup above, TLS for domain_name needs to be issued/
# terminated at whichever nginx *is* on port 80 instead — out of scope
# for this playbook; leave this false in that case.
enable_https: false
letsencrypt_email: "CHANGE ME"    # required if enable_https is true

# ---- Web dashboard password ----
# This is nginx basic auth in front of the whole dashboard — separate from,
# and not to be confused with, SSH access to the server itself. Anyone
# without this username/password gets a browser login prompt and nothing
# else, before ever reaching the Next.js app.
basic_auth_username: "CHANGE ME"
basic_auth_password: "CHANGE ME"  # plain text here only — Ansible hashes it on the server; the plaintext is never stored there

# ---- Deployment layout ----
deploy_user: "tradebot"           # dedicated non-root system user the app runs as
app_dir: "/opt/trade-bot"
node_version: "22"                # matches this repo's @types/node / engine dependency
ui_port: 3000
engine_control_api_port: 4001     # never exposed outside 127.0.0.1 — nginx only ever proxies ui_port

# ---- MongoDB / Redis ----
# Installed as native system services on this same server (no containers),
# each bound to 127.0.0.1 only — never reachable from outside the box.
# 8.0, not docker-compose.yml's mongo:7.0 -- MongoDB's official apt repo
# has no packages at all for Ubuntu 24.04 "noble" under 7.0 (confirmed
# live: repo.mongodb.org's dists/noble/mongodb-org/7.0/ 404s; 8.0 is the
# first version with real noble packages). A one-version skew from local
# dev's Docker image is a reasonable tradeoff here -- if your server runs
# an older Ubuntu (22.04 "jammy" or earlier), "7.0" works fine there and
# matches local dev exactly; check yours with `lsb_release -c`.
mongodb_version: "8.0"
mongodb_uri: "mongodb://localhost:27017/trade-bot-dev"
redis_url: "redis://localhost:6379"

# ---- Generated secret ----
# A real random value the engine's internal control API and the UI's
# server-side proxy to it both use to authenticate to each other. Generate
# one with, e.g.:  openssl rand -hex 32
engine_control_api_token: "CHANGE ME"

# ---- Binance credentials — OPTIONAL, leave every one of these blank for
# this first deployment. ----
# The engine runs correctly in paper mode with no keys set at all, which is
# the right starting point regardless of what comes later. Before ever
# setting BINANCE_FUTURES_API_KEY/SECRET here with binance_futures_use_testnet
# false, read strategies/btc-high-risk.md's "Engine port" section in full:
# the TypeScript port of that strategy has a known, still-not-fully-closed
# signal-parity gap against its own Pine backtest (91.9% match rate as of
# the last check, with one unresolved edge case and inherent feed-noise
# divergence that live-paper validation is still accumulating evidence on).
binance_api_key: ""
binance_api_secret: ""
binance_futures_api_key: ""
binance_futures_api_secret: ""
binance_use_testnet: true
binance_futures_use_testnet: true

# btc-high-risk specifically also needs THIS set true (in addition to
# binance_futures_use_testnet: false and real keys above) before it will
# ever touch a real account — a deliberate second, strategy-specific
# switch, independent of the shared testnet convention above. Leave this
# false/absent unless you have personally read strategies/btc-high-risk.md's
# "Engine port" section, understand the residual gap described there, and
# are knowingly accepting that risk with capital you can afford to lose —
# this strategy runs 100x leverage. Do not set this true as a way to get
# past an error without having made that decision deliberately.
btc_high_risk_allow_live: false

# ---- Telegram chatops — OPTIONAL. apps/chatops isn't deployed by this
# playbook (UI + engine only, per this deployment's scope) — these are
# unused for now, kept here so the .env shape matches .env.example. ----
telegram_bot_token: ""
telegram_allowed_chat_ids: ""
