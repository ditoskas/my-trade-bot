[Unit]
Description=Trade Bot UI (Next.js dashboard)
After=network.target mongod.service redis-server.service trade-bot-engine.service
Wants=trade-bot-engine.service

[Service]
Type=simple
User={{ deploy_user }}
Group={{ deploy_user }}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_dir }}/.env
Environment=PORT={{ ui_port }}
ExecStart=/usr/bin/npm run start --workspace=@trade-bot/ui
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
