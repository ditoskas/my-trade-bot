# Generated by ansible/playbook.yml from group_vars/all.yml — do not edit
# by hand, changes will be overwritten on the next deploy. Same shape as
# the repo's own .env.example.

MONGODB_URI={{ mongodb_uri }}
REDIS_URL={{ redis_url }}

ENGINE_CONTROL_API_URL=http://127.0.0.1:{{ engine_control_api_port }}
ENGINE_CONTROL_API_PORT={{ engine_control_api_port }}
ENGINE_CONTROL_API_TOKEN={{ engine_control_api_token }}

BINANCE_API_KEY={{ binance_api_key }}
BINANCE_API_SECRET={{ binance_api_secret }}
BINANCE_USE_TESTNET={{ 'true' if binance_use_testnet else 'false' }}

BINANCE_FUTURES_API_KEY={{ binance_futures_api_key }}
BINANCE_FUTURES_API_SECRET={{ binance_futures_api_secret }}
BINANCE_FUTURES_USE_TESTNET={{ 'true' if binance_futures_use_testnet else 'false' }}

# See group_vars/all.yml.example's comment on btc_high_risk_allow_live
# before ever setting this true in your own all.yml.
BTC_HIGH_RISK_ALLOW_LIVE={{ 'true' if btc_high_risk_allow_live | default(false) else 'false' }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_ALLOWED_CHAT_IDS={{ telegram_allowed_chat_ids }}
