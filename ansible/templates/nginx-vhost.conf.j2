# Generated by ansible/playbook.yml from group_vars/all.yml — do not edit
# by hand, changes will be overwritten on the next deploy.
#
# Listens on 127.0.0.1 only, NOT the public port 80/443 — this server
# already runs another service (GitLab CE) whose own bundled nginx owns
# those ports. GitLab's nginx is the actual public-facing front door for
# {{ domain_name }} and reverse-proxies to this port; see
# ansible/README.md's "Coexisting with another nginx on the same server"
# section for the one-time GitLab-side config this depends on. Basic auth
# still happens here, not at GitLab's nginx, so this port being
# loopback-only is defense in depth, not the only thing gating access.
server {
    listen 127.0.0.1:{{ nginx_internal_port }};
    server_name {{ domain_name }};

    location / {
        auth_basic "Trade Bot Dashboard";
        auth_basic_user_file /etc/nginx/.htpasswd-tradebot;

        proxy_pass http://127.0.0.1:{{ ui_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Forwarded from GitLab's nginx (the actual public-facing hop) when
        # set; falls back to this connection's own values otherwise so the
        # vhost still works if something ever connects to this port
        # directly during testing.
        proxy_set_header X-Real-IP $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The dashboard's live feed is server-sent events (app/api/stream) —
        # buffering would delay or batch it unpredictably.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
