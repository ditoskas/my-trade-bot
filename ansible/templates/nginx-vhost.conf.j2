# Generated by ansible/playbook.yml from group_vars/all.yml — do not edit
# by hand, changes will be overwritten on the next deploy.
#
# Basic auth gates the whole dashboard except the ACME HTTP-01 challenge
# path (certbot needs that reachable with no auth to issue/renew a
# certificate). If enable_https is true, run this playbook once with it
# false first to confirm the site loads over plain HTTP, then flip it true
# and re-run — certbot's nginx plugin will extend this file with the actual
# listen 443/ssl_certificate directives itself; this template only ever
# manages the HTTP server block.

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }};

    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    location / {
        auth_basic "Trade Bot Dashboard";
        auth_basic_user_file /etc/nginx/.htpasswd-tradebot;

        proxy_pass http://127.0.0.1:{{ ui_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The dashboard's live feed is server-sent events (app/api/stream) —
        # buffering would delay or batch it unpredictably.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
