# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Local dev Mongo (docker-compose.yml), also what the mongodb MCP server points at.
MONGODB_URI=mongodb://localhost:27017/trade-bot-dev

# Local dev Redis (docker-compose.yml) — the engine's live event feed (Phase 4).
REDIS_URL=redis://localhost:6379

# Engine's internal control API (Phase 4) — bound to 127.0.0.1 only. The
# token below is a dev-only placeholder; set a real shared secret outside
# local dev. apps/ui reads the same two vars to reach it server-side.
ENGINE_CONTROL_API_URL=http://127.0.0.1:4001
ENGINE_CONTROL_API_TOKEN=dev-only-insecure-token

# Binance SPOT API credentials (Phase 3, BinanceBroker/reconcile/testnet-smoke).
# Get testnet keys at https://testnet.binance.vision (GitHub login) — fake
# funds, zero financial risk. Never put real mainnet keys here for local dev.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional (Phase 6) — spot reconciliation only runs when the two keys
# above are set. Defaults shown; BINANCE_USE_TESTNET must be explicitly
# set to "false" to ever point reconciliation at a real account.
# RECONCILE_INTERVAL_MS=300000
# BINANCE_USE_TESTNET=true

# Binance FUTURES API credentials (Phase 3b, BinanceFuturesBroker/
# futures-testnet-smoke). Get testnet keys at
# https://testnet.binancefuture.com — a SEPARATE site/account system from
# the spot testnet above; these are not interchangeable. Never put real
# mainnet keys here for local dev.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Telegram chatops bot (Phase 5). Create a bot via @BotFather on Telegram
# for the token. TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated allow-list
# (e.g. "123456789") — the bot refuses to start without at least one, and
# silently ignores messages from any other chat. Message the bot once and
# check the chatops logs for your chat ID (logged when a message is
# ignored), or ask @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
