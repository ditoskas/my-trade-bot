# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Local dev Mongo (docker-compose.yml), also what the mongodb MCP server points at.
MONGODB_URI=mongodb://localhost:27017/trade-bot-dev

# Local dev Redis (docker-compose.yml) — wired up in Phase 4.
REDIS_URL=redis://localhost:6379

# Binance SPOT API credentials (Phase 3, BinanceBroker/reconcile/testnet-smoke).
# Get testnet keys at https://testnet.binance.vision (GitHub login) — fake
# funds, zero financial risk. Never put real mainnet keys here for local dev.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance FUTURES API credentials (Phase 3b, BinanceFuturesBroker/
# futures-testnet-smoke). Get testnet keys at
# https://testnet.binancefuture.com — a SEPARATE site/account system from
# the spot testnet above; these are not interchangeable. Never put real
# mainnet keys here for local dev.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
