# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Local dev Mongo (docker-compose.yml), also what the mongodb MCP server points at.
MONGODB_URI=mongodb://localhost:27017/trade-bot-dev

# Local dev Redis (docker-compose.yml) — wired up in Phase 4.
REDIS_URL=redis://localhost:6379

# Binance API credentials (Phase 3, BinanceBroker/reconcile/testnet-smoke).
# Get testnet keys at https://testnet.binance.vision — fake funds, zero
# financial risk. Never put real mainnet keys here for local dev.
BINANCE_API_KEY=
BINANCE_API_SECRET=
